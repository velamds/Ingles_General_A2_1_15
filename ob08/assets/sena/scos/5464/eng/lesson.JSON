word", "contents": [{"content": "empire", "type": "name"}, {"content": "a group of countries or regions that are controlled by one ruler or one government", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Inca Empire was very powerful.", "type": "example"}, {"content": "engenn4le15ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "independent ", "type": "name"}, {"content": "not controlled or ruled by another country", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Peru became an independent country in 1821.", "type": "example"}, {"content": "engenn4le15ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to defeat", "type": "name"}, {"content": "to win a victory over", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Peru defeated the Spanish.", "type": "example"}, {"content": "engenn4le15ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to trace", "type": "name"}, {"content": "to follow (something) back to its cause, beginning, origin: to find out where something came from", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Peruvians can trace their history to their indigenous past.", "type": "example"}, {"content": "engenn4le15ob08aud10", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "melting pot", "type": "name"}, {"content": "a mixture of cultures that come together to make one culture", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Lima is a melting pot of cultures.", "type": "example"}, {"content": "engenn4le15ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "chronological", "type": "name"}, {"content": "putting things in order on a timeline", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Please put the information in chronological order.", "type": "example"}, {"content": "engenn4le15ob08aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to establish", "type": "name"}, {"content": "to create; to build", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The Spanish established the city of Lima.", "type": "example"}, {"content": "engenn4le15ob08aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to invade", "type": "name"}, {"content": "to enter a country in order to take control by military force", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The Spanish invaded in 1531.", "type": "example"}, {"content": "engenn4le15ob08aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to capture", "type": "name"}, {"content": "to get control over a person or place", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The Spanish captured the city.", "type": "example"}, {"content": "engenn4le15ob08aud06", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": " Writing About History", "type": "heading"}, {"content": "Writing about history means including a lot of details and historical information. Writing about history shows your effective writing skills and your understanding of information.<br><br><ol><li>Research an event in history. Use more than one source.</li> <li>Stay on topic. When you write about history, you include events and issues not descriptions.</li> <li>Include the important details.</li> <li>Do not include your opinion.  It is on the history not your opinion of it.</li> <li>Write in chronological order.</li> <li>Write in the Past tense.</li></ol>", "type": "describer"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a paragraph about the city or town's past.", "type": "text"}, {"content": "Include the Past tense.", "type": "text"}, {"content": "Write facts in chronological order.", "type": "text"}, {"content": "Do not include personal opinion.", "type": "text"}, {"content": "Read the paragraph aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I organize information about historical facts.", "type": "text"}, {"content": "I write about events in history in chronological order.", "type": "text"}, {"content": "I read aloud to a partner.", "type": "text"}]}]}