contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn4le15ob10re2img01.jpg"}, {"text": "<span class =\"strong\">Waiter</span>: Hola. Can I help you?<br />\n<span class =\"strong\">John</span>: Yes, can I have a Pisco Sour, please?<br />\n<span class =\"strong\">Waiter</span>: Yes, of course.", "id": 1, "time": "5000", "image": "engenn4le15ob10re2img01.jpg"}, {"text": "<span class =\"strong\">Tourist</span>: Excuse me, is anyone sitting here?<br />\n<span class =\"strong\">John</span>: No, it's all yours. Where are you from?<br />\n<span class =\"strong\">Tourist</span>: England. You?<br />\n<span class =\"strong\">John</span>: The States. <br />\n<span class =\"strong\">Tourist</span>: Can I have a Coke, please?", "id": 2, "time": "13000", "image": "engenn4le15ob10re2img05.jpg"}, {"text": "<span class =\"strong\">John</span>: A Coke?! You should try Peru's national drink.<br />\n<span class =\"strong\">Tourist</span>: They have a national drink?<br />\n<span class =\"strong\">John</span>: Yes, the Pisco Sour. It's very refreshing after a day of touring.<br />\n<span class =\"strong\">Tourist</span>: Sure, I'll have one of those.<br />\n<span class =\"strong\">John</span>: They have a day to celebrate Pisco Sour.", "id": 3, "time": "25500", "image": "engenn4le15ob10re2img05.jpg"}, {"text": "<span class =\"strong\">Tourist</span>: Really? Wow! It must be good.<br />\n<span class =\"strong\">John</span>: I love to try the local drinks and goodies when I travel.<br />\n<span class =\"strong\">Tourist</span>: Me too! I think it's the best way to immerse yourself in a new culture.<br />\n<span class =\"strong\">John</span>: Cheers to that!<br />\n<span class =\"strong\">Tourist</span>: Let's order some Cancha Salada to go with our drinks.", "id": 4, "time": "41000", "image": "engenn4le15ob10re2img02.jpg"}], "audiosrc": "engenn4le15ob10re2aud01", "coverimg": "engenn4le15ob10re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}